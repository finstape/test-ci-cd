pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "finstape/test-ci-cd"
        DOCKER_TAG = "${env.BUILD_ID}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint') {
            steps {
                script {
                    if (sh script: 'command -v pip', returnStatus: true) == 0 {
                        sh 'pip install ruff'
                        sh 'ruff check src/ tests/'
                        sh 'ruff format --check src/ tests/'
                    } else {
                        echo "pip not found — simulating lint stage"
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    if (sh script: 'command -v pip', returnStatus: true) == 0 {
                        sh 'pip install pytest'
                        sh 'pytest -v'
                    } else {
                        echo "pip not found — simulating test stage"
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    if (sh script: 'command -v docker', returnStatus: true) == 0 {
                        sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} -t ${DOCKER_IMAGE}:latest ."
                    } else {
                        echo "Docker CLI not found — simulating docker build"
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying application..."
                sh 'echo "Deploy step completed"'
            }
        }
    }

    post {
        always {
            echo "Multistage pipeline completed"
        }
    }
}