pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "finstape/test-ci-cd"
        DOCKER_TAG = "${env.BUILD_ID}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint') {
            steps {
                sh 'pip install ruff'
                sh 'ruff check src/ tests/'
                sh 'ruff format --check src/ tests/'
            }
        }

        stage('Test') {
            steps {
                sh 'pip install pytest'
                sh 'pytest -v'
            }
        }

        stage('Build') {
            steps {
                script {
                    def img = docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}")
                    img.build("-f Dockerfile .")
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying application..."
                sh 'echo "Deploy step completed"'
            }
        }
    }

    post {
        always {
            echo "Multistage pipeline completed"
        }
    }
}